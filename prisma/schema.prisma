generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role         String   @default("STUDENT")
  image        String?
  phone        String?
  isActive     Boolean  @default(true)
  isSuperAdmin Boolean  @default(false)
  permissions  String[] @default([])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  student        Student?
  teacher        Teacher?
  parent         Parent?
  activityLogs   ActivityLog[]
  authoredNews   News[]
  announcements  Announcement[]

  @@map("users")
}

model Student {
  id              String   @id @default(cuid())
  userId          String   @unique
  studentId       String   @unique
  firstName       String
  lastName        String
  middleName      String?
  dateOfBirth     DateTime
  gender          String
  classId         String?
  admissionDate   DateTime @default(now())
  parentContact   String?
  address         String?
  profilePhoto    String?
  academicSession String?
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  class               Class?              @relation(fields: [classId], references: [id], onDelete: SetNull)
  parentLinks         ParentStudent[]
  submissions         Submission[]
  grades              Grade[]

  @@index([classId])
  @@index([userId])
  @@index([studentId])
  @@map("students")
}

model Teacher {
  id            String   @id @default(cuid())
  userId        String   @unique
  teacherId     String   @unique
  firstName     String
  lastName      String
  phone         String?
  qualification String?
  specialization String?
  hireDate      DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  classes         TeacherClass[]
  subjects        TeacherSubject[]
  assignments     Assignment[]
  gradesGiven     Grade[]
  materials       LearningMaterial[]
  classTeacherFor Class[]

  @@index([userId])
  @@index([teacherId])
  @@map("teachers")
}

model Parent {
  id        String   @id @default(cuid())
  userId    String   @unique
  firstName String
  lastName  String
  phone     String?
  address   String?
  occupation String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentLinks  ParentStudent[]

  @@index([userId])
  @@map("parents")
}

model ParentStudent {
  parentId  String
  studentId String

  parent  Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([parentId, studentId])
  @@map("parent_student")
}

model Class {
  id              String   @id @default(cuid())
  name            String
  section         String?
  level           String
  classTeacherId  String?
  academicSession String?
  capacity        Int      @default(40)
  description     String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  teacher          Teacher?           @relation(fields: [classTeacherId], references: [id], onDelete: SetNull)
  students         Student[]
  teacherClasses   TeacherClass[]
  classSubjects    ClassSubject[]
  assignments      Assignment[]
  grades           Grade[]
  announcements    Announcement[]
  materials        LearningMaterial[]

  @@index([classTeacherId])
  @@index([level])
  @@map("classes")
}

model Subject {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  description String?
  level       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teacherSubjects  TeacherSubject[]
  classSubjects    ClassSubject[]
  assignments      Assignment[]
  grades           Grade[]
  materials        LearningMaterial[]

  @@map("subjects")
}

model TeacherClass {
  teacherId String
  classId   String

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@id([teacherId, classId])
  @@map("teacher_class")
}

model TeacherSubject {
  teacherId String
  subjectId String

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([teacherId, subjectId])
  @@map("teacher_subject")
}

model ClassSubject {
  classId   String
  subjectId String

  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([classId, subjectId])
  @@map("class_subject")
}

model Assignment {
  id           String   @id @default(cuid())
  title        String
  description  String?
  instructions String?
  subjectId    String
  classId      String
  teacherId    String
  dueDate      DateTime
  maxScore     Int      @default(100)
  attachments  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subject     Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  class       Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher     Teacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  submissions Submission[]

  @@index([subjectId])
  @@index([classId])
  @@index([teacherId])
  @@map("assignments")
}

model Submission {
  id           String   @id @default(cuid())
  assignmentId String
  studentId    String
  content      String?
  files        String?
  submittedAt  DateTime @default(now())
  grade        Int?
  feedback     String?
  gradedAt     DateTime?
  gradedBy     String?
  status       String   @default("PENDING")

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([assignmentId])
  @@index([studentId])
  @@map("submissions")
}

model Grade {
  id              String   @id @default(cuid())
  studentId       String
  subjectId       String
  classId         String
  academicSession String
  term            String
  score           Float
  grade           String
  remarks         String?
  teacherId       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  student Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  class   Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([subjectId])
  @@index([classId])
  @@index([academicSession, term])
  @@map("grades")
}

model LearningMaterial {
  id          String   @id @default(cuid())
  title       String
  description String?
  type        String
  fileUrl     String?
  subjectId   String?
  classId     String?
  teacherId   String
  uploadedAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  subject  Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  class    Class?   @relation(fields: [classId], references: [id], onDelete: SetNull)
  teacher  Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([subjectId])
  @@index([classId])
  @@index([teacherId])
  @@map("learning_materials")
}

model Announcement {
  id          String   @id @default(cuid())
  title       String
  content     String
  authorId    String
  targetType  String   @default("SCHOOL")
  classId     String?
  priority    String   @default("NORMAL")
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author  User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  class   Class? @relation(fields: [classId], references: [id], onDelete: SetNull)

  @@index([authorId])
  @@index([classId])
  @@index([targetType])
  @@map("announcements")
}

model News {
  id          String    @id @default(cuid())
  title       String
  content     String
  excerpt     String?
  image       String?
  authorId    String
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@map("news")
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime
  location    String?
  image       String?
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("events")
}

model GalleryItem {
  id          String   @id @default(cuid())
  title       String
  description String?
  imageUrl    String
  category    String?
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@map("gallery_items")
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("activity_logs")
}

// Educational levels (Creche, Kindergarten, Nursery, Primary, Secondary)
// Descriptions are admin-managed so the school can update them without a developer.
model EducationalLevel {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  sortOrder   Int      @default(0)
  ageRange    String?
  tagline     String?
  description String?
  highlights  String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sortOrder])
  @@map("educational_levels")
}

// Key/value store for admin-editable website content and school information.
model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String?
  isPublic  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

// Public admission enquiries submitted from the website. Admin can review them.
model AdmissionEnquiry {
  id            String   @id @default(cuid())
  childFirstName String
  childLastName  String?
  dateOfBirth   String?
  level         String
  studentClass  String?
  parentName    String
  phone         String
  email         String   @default("")
  address       String?
  message       String?
  status        String   @default("NEW")
  createdAt     DateTime @default(now())

  @@index([status])
  @@index([createdAt])
  @@map("admission_enquiries")
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role         String   @default("STUDENT")
  image        String?
  phone        String?
  isActive     Boolean  @default(true)
  isSuperAdmin Boolean  @default(false)
  permissions  String[] @default([])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  student        Student?
  teacher        Teacher?
  parent         Parent?
  activityLogs   ActivityLog[]
  authoredNews   News[]
  announcements  Announcement[]
  createdExams   Exam[]
  notificationPreference NotificationPreference?

  @@map("users")
}

model Student {
  id              String   @id @default(cuid())
  userId          String   @unique
  studentId       String   @unique
  firstName       String
  lastName        String
  middleName      String?
  dateOfBirth     DateTime
  gender          String
  classId         String?
  admissionDate   DateTime @default(now())
  parentContact   String?
  address         String?
  profilePhoto    String?
  academicSession String?
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  class               Class?              @relation(fields: [classId], references: [id], onDelete: SetNull)
  parentLinks         ParentStudent[]
  submissions         Submission[]
  grades              Grade[]
  examAttempts        ExamAttempt[]
  examResults         ExamResult[]
  examAssignments     ExamAssignment[]

  @@index([classId])
  @@index([userId])
  @@index([studentId])
  @@map("students")
}

model Teacher {
  id            String   @id @default(cuid())
  userId        String   @unique
  teacherId     String   @unique
  firstName     String
  lastName      String
  phone         String?
  qualification String?
  specialization String?
  hireDate      DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  classes         TeacherClass[]
  subjects        TeacherSubject[]
  assignments     Assignment[]
  gradesGiven     Grade[]
  materials       LearningMaterial[]
  classTeacherFor Class[]
  exams           Exam[]

  @@index([userId])
  @@index([teacherId])
  @@map("teachers")
}

model Parent {
  id        String   @id @default(cuid())
  userId    String   @unique
  firstName String
  lastName  String
  phone     String?
  address   String?
  occupation String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentLinks  ParentStudent[]

  @@index([userId])
  @@map("parents")
}

model ParentStudent {
  parentId  String
  studentId String

  parent  Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([parentId, studentId])
  @@map("parent_student")
}

model Class {
  id              String   @id @default(cuid())
  name            String
  section         String?
  level           String
  classTeacherId  String?
  academicSession String?
  capacity        Int      @default(40)
  description     String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  teacher          Teacher?           @relation(fields: [classTeacherId], references: [id], onDelete: SetNull)
  students         Student[]
  teacherClasses   TeacherClass[]
  classSubjects    ClassSubject[]
  assignments      Assignment[]
  grades           Grade[]
  announcements    Announcement[]
  materials        LearningMaterial[]
  exams            Exam[]

  @@index([classTeacherId])
  @@index([level])
  @@map("classes")
}

model Subject {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  description String?
  level       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teacherSubjects  TeacherSubject[]
  classSubjects    ClassSubject[]
  assignments      Assignment[]
  grades           Grade[]
  materials        LearningMaterial[]
  exams            Exam[]

  @@map("subjects")
}

model TeacherClass {
  teacherId String
  classId   String

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@id([teacherId, classId])
  @@map("teacher_class")
}

model TeacherSubject {
  teacherId String
  subjectId String

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([teacherId, subjectId])
  @@map("teacher_subject")
}

model ClassSubject {
  classId   String
  subjectId String

  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([classId, subjectId])
  @@map("class_subject")
}

model Assignment {
  id           String   @id @default(cuid())
  title        String
  description  String?
  instructions String?
  subjectId    String
  classId      String
  teacherId    String
  dueDate      DateTime
  maxScore     Int      @default(100)
  attachments  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subject     Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  class       Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher     Teacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  submissions Submission[]

  @@index([subjectId])
  @@index([classId])
  @@index([teacherId])
  @@map("assignments")
}

model Submission {
  id           String   @id @default(cuid())
  assignmentId String
  studentId    String
  content      String?
  files        String?
  submittedAt  DateTime @default(now())
  grade        Int?
  feedback     String?
  gradedAt     DateTime?
  gradedBy     String?
  status       String   @default("PENDING")

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([assignmentId])
  @@index([studentId])
  @@map("submissions")
}

model Grade {
  id              String   @id @default(cuid())
  studentId       String
  subjectId       String
  classId         String
  academicSession String
  term            String
  score           Float
  grade           String
  remarks         String?
  teacherId       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  student Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  class   Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([subjectId])
  @@index([classId])
  @@index([academicSession, term])
  @@map("grades")
}

model LearningMaterial {
  id          String   @id @default(cuid())
  title       String
  description String?
  type        String
  fileUrl     String?
  subjectId   String?
  classId     String?
  teacherId   String
  uploadedAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  subject  Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  class    Class?   @relation(fields: [classId], references: [id], onDelete: SetNull)
  teacher  Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([subjectId])
  @@index([classId])
  @@index([teacherId])
  @@map("learning_materials")
}

model Announcement {
  id          String   @id @default(cuid())
  title       String
  content     String
  authorId    String
  targetType  String   @default("SCHOOL")
  classId     String?
  priority    String   @default("NORMAL")
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author  User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  class   Class? @relation(fields: [classId], references: [id], onDelete: SetNull)

  @@index([authorId])
  @@index([classId])
  @@index([targetType])
  @@map("announcements")
}

model News {
  id          String    @id @default(cuid())
  title       String
  content     String
  excerpt     String?
  image       String?
  authorId    String
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@map("news")
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime
  location    String?
  image       String?
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("events")
}

model GalleryItem {
  id          String   @id @default(cuid())
  title       String
  description String?
  imageUrl    String
  category    String?
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@map("gallery_items")
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("activity_logs")
}

// Educational levels (Creche, Kindergarten, Nursery, Primary, Secondary)
// Descriptions are admin-managed so the school can update them without a developer.
model EducationalLevel {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  sortOrder   Int      @default(0)
  ageRange    String?
  tagline     String?
  description String?
  highlights  String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sortOrder])
  @@map("educational_levels")
}

// Persistent, serverless-safe fixed-window rate limiter (shared store across
// Vercel instances). Keys are request identifiers (e.g. "login:<ip>").
model RateLimit {
  key       String   @id
  count     Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
  @@map("rate_limits")
}

// Key/value store for admin-editable website content and school information.
model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String?
  isPublic  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

// Audit log for every transactional email sent via Resend. Enables delivery
// status tracking (webhook), error/attempt history, and duplicate prevention
// (dedupHash is unique).
model EmailLog {
  id         String   @id @default(cuid())
  type       String
  to         String
  from       String
  subject    String
  status     String   @default("SENDING") // SENDING | SENT | FAILED | DELIVERED | BOUNCED | COMPLAINED | REJECTED
  error      String?
  remoteId   String? // Resend message id, used to correlate webhook events
  refId      String? // business reference (studentId, teacherId, enquiryId, announcementId, gradeId, userId)
  userId     String? // recipient account id, used for notification preferences
  body       String? // full rendered HTML, retained for auditing and retries
  attempts   Int      @default(1)
  sentAt     DateTime?
  deliveredAt DateTime?
  dedupHash  String   @unique
  campaignId String? // bulk email campaign this log belongs to
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  campaign EmailCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([refId])
  @@index([userId])
  @@index([remoteId])
  @@index([campaignId])
  @@index([createdAt])
  @@map("email_logs")
}

// A bulk email campaign composed by an administrator. Aggregates an arbitrary
// dynamic audience (students / parents / teachers / admins) into individual
// BCC-hidden messages, tracking aggregate status across all recipients.
model EmailCampaign {
  id             String   @id @default(cuid())
  subject        String
  sender         String
  categories     String[] // e.g. ["STUDENTS", "PARENTS", "TEACHERS", "ADMINS"]
  recipientCount Int      @default(0)
  status         String   @default("QUEUED") // QUEUED | SENDING | SENT | FAILED | PARTIALLY_FAILED
  sentCount      Int      @default(0)
  deliveredCount Int      @default(0)
  failedCount    Int      @default(0)
  error          String?
  body           String? // full rendered HTML, retained for auditing and retries
  requestId      String   @unique // client-generated idempotency key
  sentById       String?
  sentByEmail    String?
  sentAt         DateTime?
  completedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  logs EmailLog[]

  @@index([status])
  @@index([createdAt])
  @@map("email_campaigns")
}

// Per-user email notification preferences. Security-critical emails (password
// resets, account status, security alerts) are always sent and are not gated.
model NotificationPreference {
  id             String   @id @default(cuid())
  userId         String   @unique
  assignment     Boolean  @default(true)
  grade          Boolean  @default(true)
  feedback       Boolean  @default(true)
  announcements  Boolean  @default(true)
  materials      Boolean  @default(true)
  academicUpdates Boolean @default(true)
  exams          Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

// Public admission enquiries submitted from the website. Admin can review them.
model AdmissionEnquiry {
  id            String   @id @default(cuid())
  childFirstName String
  childLastName  String?
  dateOfBirth   String?
  level         String
  studentClass  String?
  parentName    String
  phone         String
  email         String   @default("")
  address       String?
  message       String?
  status        String   @default("NEW")
  createdAt     DateTime @default(now())

  @@index([status])
  @@index([createdAt])
  @@map("admission_enquiries")
}

// ============================================================
// ONLINE EXAMINATIONS MODULE
// ============================================================

// An examination scheduled against a class + subject. Status is a persisted
// flag (DRAFT | SCHEDULED | ACTIVE | COMPLETED | ARCHIVED); the effective
// status is also derived from startAt/endAt by the exam-status helper (so a
// SCHEDULED exam becomes ACTIVE automatically during its window).
model Exam {
  id                   String    @id @default(cuid())
  title                String
  description          String?
  instructions         String?
  classId              String
  subjectId            String
  teacherId            String? // teacher who created it (admin-created exams keep this null)
  academicSession      String
  term                 String
  startAt              DateTime
  endAt                DateTime
  durationMinutes      Int
  totalMarks           Int       @default(100)
  passMark             Int       @default(0)
  maxAttempts          Int       @default(1)
  status               String    @default("DRAFT") // DRAFT | SCHEDULED | ACTIVE | COMPLETED | ARCHIVED
  restrictToAssigned   Boolean   @default(false) // true = only examAssignments students may take it
  showResults          Boolean   @default(false) // students may view released results
  allowAnswerReview    Boolean   @default(false) // students may view correct answers
  shuffleQuestions     Boolean   @default(true)
  publishedAt          DateTime?
  createdById          String? // user who created the exam
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  class         Class             @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject       Subject           @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher       Teacher?          @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  createdBy     User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  questions     ExamQuestion[]
  assignments   ExamAssignment[]
  attempts      ExamAttempt[]
  results       ExamResult[]

  @@index([classId])
  @@index([subjectId])
  @@index([teacherId])
  @@index([status])
  @@index([academicSession, term])
  @@index([startAt])
  @@map("exams")
}

// Question types are stored as strings so additional types (e.g. MATCHING,
// FILL_BLANK) can be added later without a schema change. Multiple choice and
// true/false questions are auto-graded against a snapshot of the correct
// value; written questions are graded manually using `guidance`.
model ExamQuestion {
  id            String   @id @default(cuid())
  examId        String
  type          String // MULTIPLE_CHOICE | TRUE_FALSE | SHORT_ANSWER | LONG_ANSWER
  question      String
  marks         Int
  correctAnswer String? // MC = option key (A/B/C/D), TF = "true" | "false"
  guidance      String? // optional marking guidance for written questions
  position      Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  exam    Exam                  @relation(fields: [examId], references: [id], onDelete: Cascade)
  options ExamQuestionOption[]
  answers ExamAnswer[]

  @@index([examId])
  @@map("exam_questions")
}

model ExamQuestionOption {
  id         String @id @default(cuid())
  questionId String
  key        String // A, B, C, D...
  text       String
  isCorrect  Boolean @default(false)

  question ExamQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("exam_question_options")
}

// Optional allow-list used when an exam is restricted to specific students.
model ExamAssignment {
  examId    String
  studentId String
  createdAt DateTime @default(now())

  exam    Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([examId, studentId])
  @@index([studentId])
  @@map("exam_assignments")
}

// One student's run of an exam. A student may hold multiple attempts only up to
// Exam.maxAttempts; each attempt is identified by (exam, student, attemptNumber).
model ExamAttempt {
  id            String    @id @default(cuid())
  examId        String
  studentId     String
  attemptNumber Int       @default(1)
  startedAt     DateTime  @default(now())
  expiresAt     DateTime
  submittedAt   DateTime?
  status        String    @default("IN_PROGRESS") // IN_PROGRESS | SUBMITTED | TIMED_OUT | ABANDONED
  autoScore     Float     @default(0)
  manualScore   Float     @default(0)
  totalScore    Float?
  percentage    Float?
  passed        Boolean?
  gradedAt      DateTime?
  gradedBy      String? // user id of the teacher who finished manual grading
  lastSavedAt   DateTime?

  exam    Exam          @relation(fields: [examId], references: [id], onDelete: Cascade)
  student Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers ExamAnswer[]
  result  ExamResult?

  @@unique([examId, studentId, attemptNumber])
  @@index([studentId])
  @@index([status])
  @@index([examId])
  @@map("exam_attempts")
}

// A student answer. Snapshot fields preserve the type/marks/correct value at
// submission time so grading is stable even if the question is edited later.
model ExamAnswer {
  id            String   @id @default(cuid())
  attemptId     String
  questionId    String
  questionType  String // snapshot of question type at submission
  questionMarks Int // snapshot of question marks at submission
  selectedKey   String? // MC/TF answer selected by the student
  textValue     String? // written answer
  isCorrect     Boolean?
  awardedMarks  Float?
  feedback      String?
  gradedBy      String?
  gradedAt      DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  attempt  ExamAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question ExamQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@map("exam_answers")
}

// Released result for a completed attempt. Only shown to students when
// Exam.showResults is enabled and releasedAt is set.
model ExamResult {
  id              String    @id @default(cuid())
  examId          String
  attemptId       String    @unique
  studentId       String
  score           Float
  totalMarks      Int
  percentage      Float
  grade           String?
  passed          Boolean
  teacherFeedback String?
  releasedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  exam    Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  attempt ExamAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  student Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([examId])
  @@index([studentId])
  @@map("exam_results")
}

# STAR DreamWorks Schools - Environment Configuration
# Copy this file to .env and fill in your real values.
# DO NOT commit .env - it contains secrets.

# --- Database (Production: PostgreSQL - e.g. Neon / Vercel Postgres) ---
# DATABASE_URL is the pooled connection string used by the app at runtime.
# For Neon/Vercel Postgres, add ?pgbouncer=true&connection_limit=1 if not included.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# DATABASE_URL_UNPOOLED is the direct connection string used by Prisma for
# migrations/schema pushes (avoids the connection pooler for DDL).
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# --- NextAuth ---
# Generate with: openssl rand -base64 32  (a long random string)
NEXTAUTH_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET"

# The base URL of your deployed app (the browser-facing URL).
# Locally: http://localhost:3000
NEXTAUTH_URL="http://localhost:3000"

# --- Cloudinary (admin gallery image uploads) ---
# Public cloud name (safe for the browser). Uploads are signed server-side,
# so the API secret below must NEVER be exposed with a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Email (Resend) ---
# Resend API key for transactional email (account creation, admissions,
# announcements, assignments, results). Get one at https://resend.com/api-keys
RESEND_API_KEY="re_REPLACE_WITH_YOUR_RESEND_KEY"

# Verified sender. The domain part must be verified in Resend.
EMAIL_FROM="STAR DreamWorks Schools <school@info.stardreamworksschools.com>"

# Resend webhook signing secret. Used to verify delivery events to
# /api/webhooks/resend. Optional: leave blank to disable signature checks.
RESEND_WEBHOOK_SECRET=""

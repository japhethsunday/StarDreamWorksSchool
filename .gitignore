# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files (never commit secrets)
.env
.env.local
.env.*.local
.env.production
.env.test
.env.development
*.env
!*.env.example
!.env.example

# prisma / sqlite database (do not commit secrets or database files)
prisma/*.db
prisma/*.db-journal
prisma/*.db-shm
prisma/*.db-wal
*.sqlite
*.sqlite3

# runtime logs
server.log
server.log.err
server-pid.txt
logs/
*.log

# generated files
.prisma/
node_modules/.prisma/

# vercel
.vercel

# IDE / OS
.vscode/
.idea/
*.swp
.DS_Store

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
